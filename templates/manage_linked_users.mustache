<table border="0" class="generaltable">
    <thead>
        <tr>
            <th scope="col">{{#str}} manage_linked_users:idp, auth_shibboleth_link {{/str}}</th>
            <th scope="col">{{#str}} name {{/str}}</th>
            <th scope="col">{{#str}} email {{/str}}</th>
            <th scope="col">{{#str}} manage_linked_users:created, auth_shibboleth_link {{/str}}</th>
            <th scope="col">{{#str}} manage_linked_users:lastseen, auth_shibboleth_link {{/str}}</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        {{#linked_users}}
        <tr>
            <td>{{idp}}</td>
            <td>{{idpfirstname}} {{idplastname}}</td>
            <td>{{idpemail}}</td>
            <td>{{created}}</td>
            <td>{{lastseen}}</td>
            <td>
                <form action="{{{actionurl}}}" method="post" style="display: inline;" onsubmit="return confirm('{{#str}} manage_linked_users:confirmunlink, auth_shibboleth_link{{/str}}');">
                    <input type="hidden" name="action" value="unlink">
                    <input type="hidden" name="link_id" value="{{id}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-link p-0">{{#str}} manage_linked_users:unlink, auth_shibboleth_link{{/str}}</button>
                </form>
            </td>
        </tr>
        {{/linked_users}}
    </tbody>
</table>
